# Copy to `.env` (git-ignored) and adjust. Never commit real secrets; Stripe keys, when they
# arrive in phase 8, must be test-mode keys (sk_test_ / pk_test_) only.

# Runtime mode for the API: development | test | production
NODE_ENV=development

# Port the API listens on. The web dev server proxies /api to this port.
PORT=3000

# Postgres connection string for local development (matches docker-compose.yml). In production
# (Render) it is the Neon connection string; docs/DEPLOYMENT.md says which one (pooled or direct).
# If host port 5432 is already taken on your machine, change the left side of the port mapping in
# docker-compose.yml (e.g. '127.0.0.1:5433:5432') and use that port here and below.
DATABASE_URL=postgres://ecommerce:ecommerce@localhost:5432/ecommerce

# Separate database for integration tests, created by docker/postgres/init-test-db.sql.
# Tests truncate it freely, so it must never point at the development database.
DATABASE_URL_TEST=postgres://ecommerce:ecommerce@localhost:5432/ecommerce_test

# Browser origin of the web app. The API uses it for the CSRF origin check and CORS. In production
# it must be the https URL of the deployed web app (Vercel), or the API refuses to boot.
WEB_ORIGIN=http://localhost:5173

# Log verbosity: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Secret that signs cookies (the guest cart id). 32+ characters, required in production; in
# development a built-in fallback is used when it is empty. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
COOKIE_SECRET=

# Rate limiting. General limit per IP and window; the stricter limit applies to login/register
# (per IP + email) over its own window.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10

# Web (Vite) -----------------------------------------------------------------------------------
# API origin for web builds that do NOT proxy /api. Leave unset in dev (Vite proxies /api to the
# API) and on Vercel (rewrites /api/*): the browser then stays same-origin and cookies just work.
# VITE_API_URL=
# Stripe publishable key for the browser (Payment Element). pk_test_ ONLY: anything else is ignored
# and the payment step shows "Payments aren't configured in this environment". Publishable keys are
# public by design (unlike sk_test_), but keep live ones out anyway. Restart `pnpm dev` after a change.
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe, TEST MODE ONLY (nothing here ever touches real money). Leave empty until you have keys:
# the API still boots, and checkout answers 502 "payments are not configured".
# Anything not starting with sk_test_ / whsec_ / pk_test_ is rejected at boot. Required in production.
#   sk_test_...  Dashboard > Developers > API keys > Secret key (server only; never commit it)
STRIPE_SECRET_KEY=
#   whsec_...    printed by: stripe listen --forward-to localhost:3000/api/v1/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
#   pk_test_...  Publishable key; used by the web app (VITE_STRIPE_PUBLISHABLE_KEY mirrors it)
STRIPE_PUBLISHABLE_KEY=

# Test-only payment simulator (POST /test/webhooks/simulate). The route exists only when the API runs
# with NODE_ENV=test AND this is set (16+ characters); callers send it as `X-Test-Hook-Secret`.
# `pnpm e2e` and CI set their own throwaway value. Leave empty in development and production.
TEST_HOOK_SECRET=

# Background jobs inside the API process (every 5 minutes: gives back stock held by checkouts that
# were abandoned for 30+ minutes, and recovers payments whose webhook was lost). Set to false to run
# none, e.g. on a second instance: one sweeper is enough (an advisory lock also guarantees it).
ENABLE_JOBS=true

# Scheduled jobs (job registry: apps/api/src/jobs/runner.ts). Three free triggers, all safe together:
#   1. CLI / cron:  pnpm --filter @store/api job run [name]
#   2. JOBS_IN_PROCESS=true ticks the registry every 10 minutes inside `pnpm dev`.
#   3. Production: the scheduled GitHub Actions workflow POSTs /api/v1/internal/jobs/run with the
#      header X-Jobs-Secret = JOBS_SECRET (16+ characters; empty disables the route).
JOBS_IN_PROCESS=false
JOBS_SECRET=

# Email (order confirmation and shipped). Sent through a database outbox, so a mail outage never
# fails a checkout. Development: leave SMTP_URL empty and Mailpit (docker compose up -d) catches
# everything at http://localhost:8025. Production: set RESEND_API_KEY (free tier) or an SMTP_URL;
# with neither, emails are logged and skipped and the API still boots.
#   smtp://host:port or smtps://user:pass@host:port
SMTP_URL=
#   re_... from resend.com > API keys. Sent over Resend's SMTP endpoint (smtp.resend.com:465).
RESEND_API_KEY=
# Sender. Without a verified domain Resend only accepts onboarding@resend.dev and only delivers
# to the address you signed up with.
MAIL_FROM="Pawsome <orders@pawsome.test>"
# Where the contact form's "new message" notification for the shop is sent. Mailpit locally.
SHOP_INBOX_EMAIL=hello@pawsome.test

# Tooling only (none of these are needed to run the app) -----------------------------------------
# Where `pnpm dev` (Vite) forwards /api. Default http://localhost:3000. Set it when the API runs
# on another port, e.g. a production-build smoke test: API_PROXY_TARGET=http://localhost:3400
# API_PROXY_TARGET=
# Where the e2e suite starts its own API and web server (defaults 3100 and 5273), so it never
# collides with `pnpm dev`.
# E2E_API_PORT=3100
# E2E_WEB_PORT=5273
# Mailpit HTTP API the e2e suite reads emails from (default http://localhost:8025).
# MAILPIT_URL=http://localhost:8025

# Review photo uploads (phase 17). Files are re-encoded to WebP and written under UPLOAD_DIR
# (relative to apps/api) and served at /api/v1/uploads. Render's free disk is EPHEMERAL, so on the
# public demo set UPLOADS_ENABLED=false and rely on the committed seed photos.
UPLOAD_DIR=uploads
UPLOADS_ENABLED=true

# Copy to `.env` (git-ignored) and adjust. Never commit real secrets; Stripe keys, when they
# arrive in phase 8, must be test-mode keys (sk_test_ / pk_test_) only.

# Runtime mode for the API: development | test | production
NODE_ENV=development

# Port the API listens on. The web dev server proxies /api to this port.
PORT=3000

# Postgres connection string for local development (matches docker-compose.yml).
# If host port 5432 is already taken on your machine, change the left side of the port mapping in
# docker-compose.yml (e.g. '127.0.0.1:5433:5432') and use that port here and below.
DATABASE_URL=postgres://ecommerce:ecommerce@localhost:5432/ecommerce

# Separate database for integration tests, created by docker/postgres/init-test-db.sql.
# Tests truncate it freely, so it must never point at the development database.
DATABASE_URL_TEST=postgres://ecommerce:ecommerce@localhost:5432/ecommerce_test

# Browser origin of the web app. The API uses it for the CSRF origin check and CORS in production.
WEB_ORIGIN=http://localhost:5173

# Log verbosity: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Secret that signs cookies (the guest cart id). 32+ characters, required in production; in
# development a built-in fallback is used when it is empty. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
COOKIE_SECRET=

# Rate limiting. General limit per IP and window; the stricter limit applies to login/register
# (per IP + email) over its own window.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10

# Web (Vite) -----------------------------------------------------------------------------------
# API origin for web builds that do NOT proxy /api. Leave unset in dev (Vite proxies /api to the
# API) and on Vercel (rewrites /api/*): the browser then stays same-origin and cookies just work.
# VITE_API_URL=

# Stripe, TEST MODE ONLY (nothing here ever touches real money). Leave empty until you have keys:
# the API still boots, and checkout answers 502 "payments are not configured".
# Anything not starting with sk_test_ / whsec_ / pk_test_ is rejected at boot. Required in production.
#   sk_test_...  Dashboard > Developers > API keys > Secret key (server only; never commit it)
STRIPE_SECRET_KEY=
#   whsec_...    printed by: stripe listen --forward-to localhost:3000/api/v1/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
#   pk_test_...  Publishable key; used by the web app (VITE_STRIPE_PUBLISHABLE_KEY mirrors it)
STRIPE_PUBLISHABLE_KEY=

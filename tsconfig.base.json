{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    // Bundler resolution: workspace packages resolve through their package.json `exports`,
    // and imports need no file extensions. Vite and tsx both understand it.
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "composite": true,
    // Shared sources are compiled by api (NodeNext, needs extensions) and web (bundler), so they
    // write real .ts extensions; every consumer must therefore allow them.
    "allowImportingTsExtensions": true
  }
}
